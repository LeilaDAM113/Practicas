@model Max_Mvc.Models.MDificultad

@{
    ViewData["Title"] = "Detalles de la Dificultad";
}

<div class="container mt-4">
    <h1>Detalles de la Dificultad</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            @* Tabla Vertical de Detalles *@
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <th class="bg-light" style="width: 30%;">ID</th>
                        <td>@Html.DisplayFor(model => model.Id)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Descripción</th>
                        <td>@Html.DisplayFor(model => model.Descripcion)</td>
                    </tr>
                </tbody>
            </table>

            @* Botones de Acción inferior *@
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>