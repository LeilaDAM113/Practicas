@model Max_Mvc.Models.MDificultad

@{
    ViewData["Title"] = "Eliminar Dificultad";
}

<div class="container mt-4">
    <h1>Eliminar Dificultad</h1>
    <h3 class="text-danger">¿Estás seguro de que deseas borrar este registro?</h3>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <th class="bg-light" style="width: 30%;">ID</th>
                        <td>@Html.DisplayFor(model => model.Id)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Descripción</th>
                        <td>@Html.DisplayFor(model => model.Descripcion)</td>
                    </tr>
                </tbody>
            </table>

            <form asp-action="Delete" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Sí, Eliminar" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar y Volver</a>
            </form>
        </div>
    </div>
</div>
