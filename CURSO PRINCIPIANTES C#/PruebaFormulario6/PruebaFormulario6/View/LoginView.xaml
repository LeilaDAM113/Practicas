<base:BaseView x:Class="PruebaFormulario5.View.LoginView"
               x:TypeArguments="vm:LoginViewModel"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:local="clr-namespace:PruebaFormulario5.View"
               xmlns:base="clr-namespace:PruebaFormulario6.View.Base"
               xmlns:vm="clr-namespace:PruebaFormulario5.ViewModel"
               mc:Ignorable="d"
               Title="LoginView" Height="450" Width="800">
	<StackPanel>
		<Label Content="Username"/>
		<TextBox x:Name="TextBoxUsername" Text="{Binding UserName}"/>
		<Label Content="Password"/>
		<TextBox x:Name="TextBoxPassword" Text="{Binding PassWord}"/>
		<Button x:Name="ButtonLogin" Content="Login" Command="{Binding doLoginCommand}" Width="100" HorizontalAlignment="Left"/>
	</StackPanel>
</base:BaseView>