<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
	  <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Soccer.Domain\Soccer.Domain.csproj" />
		<ProjectReference Include="..\Soccer.Notification.Abstractions\Soccer.Notification.Abstractions.csproj" />
		<ProjectReference Include="..\Soccer.Persistence.Abstractions\Soccer.Persistence.Abstractions.csproj" />
	</ItemGroup>

</Project>